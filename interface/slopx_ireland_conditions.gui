# Ireland Total Overhaul — National Conditions Panel.
# GUI-only surface contract. The scripted-GUI registration owns visibility, state swaps,
# click effects and dirty refresh; every visible string is a stable localisation key.
# Live runtime sources: slopx_ireland_provision_food, slopx_ireland_provision_energy,
# slopx_ireland_provision_transport, slopx_ireland_provision_maritime,
# slopx_ireland_provision_display, slopx_ireland_readiness_command,
# slopx_ireland_readiness_equipment, slopx_ireland_readiness_mobilisation,
# slopx_ireland_readiness_supply, slopx_ireland_readiness_warning,
# slopx_ireland_readiness_maritime_protection, slopx_ireland_readiness_intelligence,
# slopx_ireland_readiness_display and slopx_ireland_neutrality_integrity.
# Registration handoff: window_name = slopx_ireland_conditions_panel_window
# context_type = decision_category; no parent-window token is used.
# dirty = slopx_ireland_conditions_gui_dirty
# click hooks = *_food_row, *_energy_row, *_transport_row, *_maritime_row,
# *_command_row, *_equipment_row, *_mobilisation_row, *_supply_row, *_warning_row,
# *_maritime_protection_row, *_intelligence_row, *_neutrality_row,
# *_provision_critical_slot, *_readiness_critical_slot, *_neutrality_critical_slot,
# *_review_button, *_close_button.

guiTypes = {
	containerWindowType = {
