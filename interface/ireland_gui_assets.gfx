# Static presentation assets for the three Ireland scripted GUI surfaces. Runtime DDS files live under gfx/interface/ireland/gui/.
# The generated package's source, processed, and static-fallback evidence remains under assets/.
spriteTypes = {
	spriteType = { name = GFX_ireland_gui_conditions_background texturefile = "gfx/interface/ireland/gui/conditions/background.dds" }
	spriteType = { name = GFX_ireland_gui_northern_background texturefile = "gfx/interface/ireland/gui/northern/background.dds" }
	spriteType = { name = GFX_ireland_gui_evidence_background texturefile = "gfx/interface/ireland/gui/evidence/background.dds" }
	spriteType = { name = GFX_ireland_gui_status_ready texturefile = "gfx/interface/ireland/gui/shared/status_ready.dds" }
