	spriteType = { name = GFX_ireland_gui_status_ready texturefile = "gfx/interface/ireland/gui/shared/status_ready.dds" }
	spriteType = { name = GFX_ireland_gui_status_locked texturefile = "gfx/interface/ireland/gui/shared/status_locked.dds" }
	spriteType = { name = GFX_ireland_gui_status_warning texturefile = "gfx/interface/ireland/gui/shared/status_warning.dds" }
	spriteType = { name = GFX_ireland_gui_status_critical texturefile = "gfx/interface/ireland/gui/shared/status_critical.dds" }
	textSpriteType = {
		name = "GFX_ireland_gui_value_row"
