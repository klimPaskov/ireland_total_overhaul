# Ireland Total Overhaul - compact Concealed Evidence / public dossier panel.
# The sealed and revealed states share one decision-category-sized surface;
# scripted-GUI visibility triggers decide which ledger is shown.
# Registration handoff: window_name = ireland_concealed_evidence_ledger_window
# context_type = decision_category; dirty = ireland_evidence_gui_dirty

guiTypes = {
	containerWindowType = {
		name = "ireland_concealed_evidence_ledger_window"
