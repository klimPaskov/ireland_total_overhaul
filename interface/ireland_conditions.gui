# Ireland Total Overhaul - compact Dail decision-category panel.
# This follows the vanilla USA Congress pattern: a short, read-only political
# summary above the decisions. Decisions remain the only interactive entries.
guiTypes = {
	containerWindowType = {
		name = "ireland_parliament_panel_window"
		orientation = upper_left
		position = { x = 0 y = 0 }
		size = { width = 510 height = 286 }
		clipping = yes

		background = {
			name = "ireland_parliament_panel_background"
			quadTextureSprite = "GFX_ireland_gui_conditions_background"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "ireland_parliament_title"
			position = { x = 18 y = 10 }
			text = "ireland_parliament_title"
			font = "hoi_24header"
			format = left
			maxWidth = 300
			maxHeight = 28
		}
		instantTextBoxType = {
