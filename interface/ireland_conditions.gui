# Ireland Total Overhaul - compact National Conditions decision-category panel.
# The scripted-GUI registration owns visibility, state swaps, click effects, and
# dirty refresh. This window is deliberately sized for the vanilla 510px
# decision grid rather than behaving like a separate full-screen interface.
# Registration handoff: window_name = ireland_conditions_panel_window
# context_type = decision_category; dirty = ireland_conditions_gui_dirty

guiTypes = {
	containerWindowType = {
		name = "ireland_conditions_panel_window"
		orientation = upper_left
		position = { x = 0 y = 0 }
		size = { width = 510 height = 590 }
		clipping = no

		background = {
			name = "ireland_conditions_panel_background"
			quadTextureSprite = "GFX_ireland_gui_conditions_background"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "ireland_conditions_panel_title"
			position = { x = 16 y = 10 }
