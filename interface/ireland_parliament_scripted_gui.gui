# Ireland Total Overhaul - interactive Parliament chamber and opening programme.
# Human players use the four scripted-GUI controls below; the matching native
# decisions remain an AI-only execution path with the same gates and effects.
@PARLIAMENT_WIDTH = 510
@PARLIAMENT_HEIGHT = 248
@TITLE_Y = 1

@CHAMBER_WIDTH = 247
@CHAMBER_HEIGHT = 126
@CHAMBER_PANEL_Y = 22
@DAIL_PANEL_X = 4
@SEANAD_PANEL_X = 259
@CHAMBER_HEADER_LOCAL_Y = 0
@DAIL_ICON_LOCAL_X = 61
@DAIL_ICON_LOCAL_Y = 19
@SEANAD_ICON_LOCAL_X = 61
@SEANAD_ICON_LOCAL_Y = 19
@CHAMBER_STATUS_LOCAL_Y = 90
@CHAMBER_COMPOSITION_LOCAL_Y = 108

@POWERS_PANEL_Y = 148
@POWERS_PANEL_HEIGHT = 100
@POWERS_HEADER_LOCAL_Y = 0
@POWER_LEFT_X = 44
@POWER_RIGHT_X = 296
@POWER_FIRST_ROW_Y = 20
@POWER_SECOND_ROW_Y = 60
@POWER_STATE_LEFT_X = 10
@POWER_STATE_RIGHT_X = 262
@POWER_STATE_FIRST_ROW_Y = 20
@POWER_STATE_SECOND_ROW_Y = 60

guiTypes = {
	containerWindowType = {
		name = "ireland_parliament_decision_ui_window"
		position = { x = 0 y = 0 }
		size = { width = @PARLIAMENT_WIDTH height = @PARLIAMENT_HEIGHT }

		background = {
			name = "ireland_parliament_background"
			quadTextureSprite = "GFX_ireland_parliament_summary_background"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "ireland_parliament_title"
			position = { x = 0 y = @TITLE_Y }
			font = "vic_18_black"
			text = "ireland_parliament_title"
			format = center
			fixedsize = yes
			maxWidth = @PARLIAMENT_WIDTH
			maxHeight = 18
		}

		containerWindowType = {
			name = "ireland_parliament_dail_panel"
			position = { x = @DAIL_PANEL_X y = @CHAMBER_PANEL_Y }
			size = { width = @CHAMBER_WIDTH height = @CHAMBER_HEIGHT }

			instantTextBoxType = {
				name = "ireland_dail_support_header"
				position = { x = 0 y = @CHAMBER_HEADER_LOCAL_Y }
				font = "vic_18_black"
				text = "ireland_parliament_dail_header"
				format = center
				fixedsize = yes
				maxWidth = @CHAMBER_WIDTH
				maxHeight = 18
			}

			iconType = {
				name = "dail_icon"
				spriteType = "GFX_ireland_parliament_dail_large_ui"
				position = { x = @DAIL_ICON_LOCAL_X y = @DAIL_ICON_LOCAL_Y }
				alwaystransparent = yes
			}

			instantTextBoxType = {
				name = "ireland_dail_support_status"
				position = { x = 0 y = @CHAMBER_STATUS_LOCAL_Y }
				font = "Main_14_black"
				text = "ireland_parliament_dail_status"
				pdx_tooltip = "ireland_parliament_dail_status_tt"
				format = center
				fixedsize = yes
				maxWidth = @CHAMBER_WIDTH
				maxHeight = 18
			}

			instantTextBoxType = {
				name = "ireland_dail_composition"
				position = { x = 0 y = @CHAMBER_COMPOSITION_LOCAL_Y }
				font = "Main_14_black"
				text = "ireland_parliament_dail_composition"
				pdx_tooltip = "ireland_parliament_dail_composition_tt"
				format = center
				fixedsize = yes
				maxWidth = @CHAMBER_WIDTH
				maxHeight = 18
			}
		}

		containerWindowType = {
			name = "ireland_parliament_seanad_panel"
			position = { x = @SEANAD_PANEL_X y = @CHAMBER_PANEL_Y }
			size = { width = @CHAMBER_WIDTH height = @CHAMBER_HEIGHT }

			instantTextBoxType = {
				name = "ireland_seanad_support_header"
				position = { x = 0 y = @CHAMBER_HEADER_LOCAL_Y }
				font = "vic_18_black"
				text = "ireland_parliament_seanad_header"
				format = center
				fixedsize = yes
				maxWidth = @CHAMBER_WIDTH
				maxHeight = 18
			}

			iconType = {
				name = "seanad_icon"
				spriteType = "GFX_ireland_parliament_seanad_large_ui"
				position = { x = @SEANAD_ICON_LOCAL_X y = @SEANAD_ICON_LOCAL_Y }
				alwaystransparent = yes
			}

			instantTextBoxType = {
				name = "ireland_seanad_support_status"
				position = { x = 0 y = @CHAMBER_STATUS_LOCAL_Y }
				font = "Main_14_black"
				text = "ireland_parliament_seanad_status"
				pdx_tooltip = "ireland_parliament_seanad_status_tt"
				format = center
				fixedsize = yes
				maxWidth = @CHAMBER_WIDTH
				maxHeight = 18
			}

			instantTextBoxType = {
				name = "ireland_seanad_composition"
				position = { x = 0 y = @CHAMBER_COMPOSITION_LOCAL_Y }
				font = "Main_14_black"
				text = "ireland_parliament_seanad_composition"
				pdx_tooltip = "ireland_parliament_seanad_composition_tt"
				format = center
				fixedsize = yes
				maxWidth = @CHAMBER_WIDTH
				maxHeight = 18
			}
		}

		containerWindowType = {
			name = "ireland_parliament_powers_panel"
			position = { x = 0 y = @POWERS_PANEL_Y }
			size = { width = @PARLIAMENT_WIDTH height = @POWERS_PANEL_HEIGHT }

			instantTextBoxType = {
				name = "ireland_parliament_powers_header"
				position = { x = 0 y = @POWERS_HEADER_LOCAL_Y }
				font = "hoi_16mbs"
				text = "ireland_parliament_powers_header"
				format = center
				fixedsize = yes
				maxWidth = @PARLIAMENT_WIDTH
				maxHeight = 16
			}

			buttonType = {
				name = "ireland_parliament_dail_button"
				position = { x = @POWER_LEFT_X y = @POWER_FIRST_ROW_Y }
				quadTextureSprite = "GFX_ireland_gui_parliament_step_button"
				buttonFont = "hoi_16mbs"
				buttonText = "ireland_parliament_dail_button_label"
				format = center
				clicksound = click_default
				pdx_tooltip = "ireland_parliament_dail_button_tt"
			}

			buttonType = {
				name = "ireland_parliament_seanad_button"
				position = { x = @POWER_RIGHT_X y = @POWER_FIRST_ROW_Y }
				quadTextureSprite = "GFX_ireland_gui_parliament_step_button"
				buttonFont = "hoi_16mbs"
				buttonText = "ireland_parliament_seanad_button_label"
				format = center
				clicksound = click_default
				pdx_tooltip = "ireland_parliament_seanad_button_tt"
			}

			buttonType = {
				name = "ireland_parliament_confidence_button"
				position = { x = @POWER_LEFT_X y = @POWER_SECOND_ROW_Y }
				quadTextureSprite = "GFX_ireland_gui_parliament_step_button"
				buttonFont = "hoi_16mbs"
				buttonText = "ireland_parliament_confidence_button_label"
				format = center
				clicksound = click_default
				pdx_tooltip = "ireland_parliament_confidence_button_tt"
			}

			buttonType = {
				name = "ireland_parliament_budget_button"
				position = { x = @POWER_RIGHT_X y = @POWER_SECOND_ROW_Y }
				quadTextureSprite = "GFX_ireland_gui_parliament_step_button"
				buttonFont = "hoi_16mbs"
				buttonText = "ireland_parliament_budget_button_label"
				format = center
				clicksound = click_default
				pdx_tooltip = "ireland_parliament_budget_button_tt"
			}

			# The four-frame seal avoids layered elements while retaining the complete
			# action vocabulary: slate locked, amber unaffordable, gold current, and
			# green secured. Red remains reserved for genuine failure states.
			iconType = {
				name = "ireland_parliament_power_dail_state"
				spriteType = "GFX_ireland_gui_parliament_action_state"
				position = { x = @POWER_STATE_LEFT_X y = @POWER_STATE_FIRST_ROW_Y }
				frame = 1
				pdx_tooltip = "ireland_parliament_power_state_tt"
				alwaystransparent = yes
			}
			iconType = {
				name = "ireland_parliament_power_seanad_state"
				spriteType = "GFX_ireland_gui_parliament_action_state"
				position = { x = @POWER_STATE_RIGHT_X y = @POWER_STATE_FIRST_ROW_Y }
				frame = 1
				pdx_tooltip = "ireland_parliament_power_state_tt"
				alwaystransparent = yes
			}
			iconType = {
				name = "ireland_parliament_power_confidence_state"
				spriteType = "GFX_ireland_gui_parliament_action_state"
				position = { x = @POWER_STATE_LEFT_X y = @POWER_STATE_SECOND_ROW_Y }
				frame = 1
				pdx_tooltip = "ireland_parliament_power_state_tt"
				alwaystransparent = yes
			}
			iconType = {
				name = "ireland_parliament_power_budget_state"
				spriteType = "GFX_ireland_gui_parliament_action_state"
				position = { x = @POWER_STATE_RIGHT_X y = @POWER_STATE_SECOND_ROW_Y }
				frame = 1
				pdx_tooltip = "ireland_parliament_power_state_tt"
				alwaystransparent = yes
			}
		}
	}
}
