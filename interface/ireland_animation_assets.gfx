		name = GFX_ireland_hidden_evidence_seal_reveal_animated
		texturefile = "gfx/interface/animated/ireland/hidden_evidence_seal_reveal/sheets/hidden_evidence_seal_reveal_sheet.dds"
		noOfFrames = 6
		animation_rate_fps = 6
		looping = no
		play_on_show = yes
		pause_on_loop = 0.0
	}

