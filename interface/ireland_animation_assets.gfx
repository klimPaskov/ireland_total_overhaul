# Ireland's seven independent frame-based animations and their static fallbacks. Runtime DDS files live under gfx/interface/animated/ireland/; frames and previews remain under assets/.
# Sheets use the vanilla frameAnimatedSpriteType contract: horizontal frames,
# noOfFrames, animation_rate_fps, looping, play_on_show and pause_on_loop.
spriteTypes = {
	spriteType = {
		name = GFX_ireland_hidden_evidence_seal_reveal
