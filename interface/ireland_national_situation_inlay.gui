# Compact Ireland Cabinet Briefing shown in the national-focus view.
guiTypes = {
	containerWindowType = {
		name = "ireland_national_situation_inlay_window"
		orientation = lower_left
		position = { x = 0 y = 0 }
		size = { width = 460 height = 248 }
		clipping = no

		background = { name = "ireland_focus_briefing_background" quadTextureSprite = "GFX_ireland_mechanics_hub_inlay_background" alwaystransparent = yes }
		instantTextBoxType = { name = "ireland_focus_briefing_title" position = { x = 12 y = 8 } text = "ireland_briefing_title" font = "hoi_24header" format = center maxWidth = 436 maxHeight = 28 }
		instantTextBoxType = { name = "ireland_focus_briefing_subtitle" position = { x = 20 y = 38 } text = "ireland_briefing_inlay_subtitle" font = "hoi_16mbs" format = center maxWidth = 420 maxHeight = 20 }

		iconType = { name = "ireland_focus_briefing_government_icon" spriteType = "GFX_decision_category_ireland_settlement_government" position = { x = 34 y = 62 } pdx_tooltip = "ireland_briefing_government_tt" }
		iconType = { name = "ireland_focus_briefing_supply_icon" spriteType = "GFX_decision_category_ireland_provision" position = { x = 139 y = 62 } pdx_tooltip = "ireland_briefing_supply_tt" }
		iconType = { name = "ireland_focus_briefing_defence_icon" spriteType = "GFX_decision_category_ireland_readiness" position = { x = 244 y = 62 } pdx_tooltip = "ireland_briefing_defence_tt" }
		iconType = { name = "ireland_focus_briefing_northern_icon" spriteType = "GFX_decision_category_ireland_northern" position = { x = 349 y = 62 } pdx_tooltip = "ireland_briefing_northern_tt" }

		instantTextBoxType = { name = "ireland_focus_briefing_government_label" position = { x = 7 y = 105 } text = "ireland_briefing_government" font = "hoi_16mbs" format = center maxWidth = 105 maxHeight = 18 alwaystransparent = yes }
		instantTextBoxType = { name = "ireland_focus_briefing_supply_label" position = { x = 112 y = 105 } text = "ireland_briefing_supply" font = "hoi_16mbs" format = center maxWidth = 105 maxHeight = 18 alwaystransparent = yes }
		instantTextBoxType = { name = "ireland_focus_briefing_defence_label" position = { x = 217 y = 105 } text = "ireland_briefing_defence" font = "hoi_16mbs" format = center maxWidth = 105 maxHeight = 18 alwaystransparent = yes }
		instantTextBoxType = { name = "ireland_focus_briefing_northern_label" position = { x = 322 y = 105 } text = "ireland_briefing_northern" font = "hoi_16mbs" format = center maxWidth = 105 maxHeight = 18 alwaystransparent = yes }

		instantTextBoxType = { name = "ireland_focus_briefing_government_value" position = { x = 7 y = 126 } context_aware_text = [GetIrelandCabinetGovernmentStatus] font = "hoi_16mbs" format = center maxWidth = 105 maxHeight = 20 alwaystransparent = yes }
		instantTextBoxType = { name = "ireland_focus_briefing_supply_value" position = { x = 112 y = 126 } context_aware_text = [GetIrelandCabinetSupplyStatus] font = "hoi_16mbs" format = center maxWidth = 105 maxHeight = 20 alwaystransparent = yes }
		instantTextBoxType = { name = "ireland_focus_briefing_defence_value" position = { x = 217 y = 126 } context_aware_text = [GetIrelandCabinetDefenceStatus] font = "hoi_16mbs" format = center maxWidth = 105 maxHeight = 20 alwaystransparent = yes }
		instantTextBoxType = { name = "ireland_focus_briefing_northern_value" position = { x = 322 y = 126 } context_aware_text = [GetIrelandCabinetNorthernStatus] font = "hoi_16mbs" format = center maxWidth = 105 maxHeight = 20 alwaystransparent = yes }

		instantTextBoxType = { name = "ireland_focus_briefing_assessment" position = { x = 24 y = 164 } context_aware_text = [GetIrelandCabinetAssessment] font = "hoi_16mbs" format = center maxWidth = 412 maxHeight = 48 alwaystransparent = yes }
	}
}
