# Ireland Total Overhaul - compact Northern Settlement decision-category ledger.
# The window stays inside the vanilla decision grid and leaves long explanations
# to the row tooltips. The scripted-GUI control names are stable API names.
# Registration handoff: window_name = ireland_northern_settlement_ledger_window
# context_type = decision_category; dirty = ireland_northern_gui_dirty

guiTypes = {
	containerWindowType = {
		name = "ireland_northern_settlement_ledger_window"
		orientation = upper_left
		position = { x = 0 y = 0 }
		size = { width = 510 height = 510 }
		clipping = no

